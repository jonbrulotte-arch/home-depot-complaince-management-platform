DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sympl_cm"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Needed when not deployed on Vercel (e.g. self-hosted or local `next start`)
AUTH_TRUST_HOST=true
# Initial admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Administrator"
# Address people open the platform at, used in invitation links (default: the address the admin used)
# APP_URL="http://your-server:8014"
# Email through Microsoft Graph, for user invitations: an Azure AD app registration with the
# Mail.Send application permission (admin consent granted), and the mailbox it sends from
# MS_GRAPH_TENANT_ID=""
# MS_GRAPH_CLIENT_ID=""
# MS_GRAPH_CLIENT_SECRET=""
# MS_GRAPH_SENDER="noreply@yourcompany.com"
# Time zone for showing times before a browser has reported its own (default America/Los_Angeles)
# DEFAULT_TIME_ZONE="America/Los_Angeles"
# Where backups are stored on the server (default ./backups)
# BACKUP_DIR="/var/backups/sympl-cm"
