DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sympl_cm"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Needed when not deployed on Vercel (e.g. self-hosted or local `next start`)
AUTH_TRUST_HOST=true
# Initial admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Administrator"
# Where backups are stored on the server (default ./backups)
# BACKUP_DIR="/var/backups/sympl-cm"
